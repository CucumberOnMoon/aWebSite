.page { height: 100vh; background: #0d1117; padding-bottom: 20px; }

/* 用户选择器 */
.user-picker {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px; background: #161b22; border-bottom: 1px solid #30363d;
}
.user-picker-left { display: flex; align-items: center; gap: 6px; }
.user-label { font-size: 13px; color: #8b949e; }
.picker-box {
  display: flex; align-items: center; gap: 6px;
  background: #0d1117; border: 1px solid #30363d; border-radius: 8px; padding: 6px 12px;
}
.picker-text { font-size: 14px; color: #58a6ff; font-weight: 500; }
.picker-arrow { font-size: 10px; color: #8b949e; }

/* 用户下拉 */
.ud-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6); z-index: 200;
  display: flex; align-items: flex-end;
}
.ud-panel {
  width: 100%; background: #161b22; border-radius: 16px 16px 0 0;
  padding: 18px 16px 24px; border-top: 1px solid #30363d;
}
.ud-title { display: block; font-size: 15px; font-weight: 600; color: #e6edf3; margin-bottom: 12px; }
.ud-scroll { max-height: 50vh; }
.ud-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 8px; border-bottom: 1px solid #21262d;
}
.ud-cur { background: rgba(88,166,255,0.08); border-radius: 8px; }
.ud-name { font-size: 15px; color: #c9d1d9; }
.ud-check { font-size: 15px; color: #58a6ff; }
.ud-close {
  display: block; text-align: center; margin-top: 14px;
  font-size: 14px; color: #8b949e; padding: 10px;
}

/* 顶部 */
.hd { padding: 20px 16px 8px; }
.hd-top { display: flex; align-items: flex-start; justify-content: space-between; }
.hd-title { display: block; font-size: 20px; font-weight: 700; color: #e6edf3; }
.hd-sub { display: block; font-size: 11px; color: #8b949e; margin-top: 4px; }
.add-btn {
  font-size: 13px; color: #58a6ff; border: 1px solid #58a6ff;
  border-radius: 16px; padding: 6px 14px; flex-shrink: 0;
}

/* 提示 */
.hint { text-align: center; padding: 80px 16px; font-size: 14px; color: #8b949e; }
.retry-btn {
  display: inline-block; margin-top: 14px; padding: 8px 24px; border-radius: 6px;
  background: #21262d; color: #58a6ff; font-size: 14px; border: 1px solid #30363d;
}

/* 卡片 */
.card {
  margin: 8px 16px; background: #161b22; border: 1px solid #30363d;
  border-radius: 12px; padding: 14px 16px;
}
.card-title { display: block; font-size: 15px; font-weight: 600; color: #e6edf3; margin-bottom: 12px; }
.card-sub { font-size: 11px; color: #8b949e; font-weight: 400; margin-left: 6px; }

/* 围度网格 */
.m-grid { display: flex; flex-wrap: wrap; }
.m-cell { width: 33.33%; text-align: center; padding: 8px 0; }
.mv { display: block; font-size: 22px; font-weight: 700; color: #e6edf3; line-height: 1.25; }
.mv-empty { color: #6e7681; font-size: 15px; font-weight: 400; }
.ml { display: block; font-size: 11px; color: #8b949e; margin-top: 3px; }
.mtier {
  display: inline-block; margin-top: 5px;
  font-size: 9px; padding: 1px 7px; border-radius: 8px;
  border: 1px solid; font-weight: 600; line-height: 1.6;
}

/* 派生指标 */
.d-row {
  display: flex; align-items: center; padding: 9px 0;
  border-top: 1px solid rgba(255,255,255,.05);
}
.d-row:first-of-type { border-top: none; }
.d-label { flex: 1; font-size: 14px; color: #c9d1d9; }
.d-val { font-size: 16px; font-weight: 700; color: #58a6ff; min-width: 62px; text-align: right; }
.d-ref { font-size: 10px; color: #6e7681; width: 100px; text-align: right; }

/* 历史表 */
.h-head, .h-row { display: flex; align-items: center; padding: 7px 0; }
.h-head { border-bottom: 1px solid #30363d; }
.h-row { border-bottom: 1px solid rgba(255,255,255,.04); }
.h-row:last-child { border-bottom: none; }
.h-c { flex: 1; font-size: 11px; color: #c9d1d9; text-align: center; }
.h-c-date { flex: 1.5; text-align: left; color: #8b949e; font-size: 10px; }
.h-head .h-c { color: #6e7681; font-size: 10px; }
.h-null { color: #484f58; }

.tip { text-align: center; font-size: 10px; color: #6e7681; padding: 16px 20px 8px; line-height: 1.6; }

/* 弹窗 */
.modal-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.65); z-index: 300;
  display: flex; align-items: center; justify-content: center;
}
.modal-box {
  width: 86%; max-width: 360px; background: #161b22;
  border: 1px solid #30363d; border-radius: 14px; padding: 18px 16px;
}
.modal-title { display: block; font-size: 16px; font-weight: 600; color: #e6edf3; margin-bottom: 14px; }
.mf-row { display: flex; align-items: center; margin-bottom: 10px; }
.mf-label { width: 52px; font-size: 13px; color: #8b949e; }
.mf-input {
  flex: 1; background: #0d1117; border: 1px solid #30363d;
  border-radius: 8px; padding: 7px 10px; font-size: 14px; color: #e6edf3;
}
.mf-tips { display: block; font-size: 10px; color: #6e7681; margin: 6px 0 14px; line-height: 1.5; }
.mf-actions { display: flex; justify-content: flex-end; gap: 12px; }
.mf-cancel, .mf-save { font-size: 14px; padding: 7px 18px; border-radius: 8px; }
.mf-cancel { color: #8b949e; border: 1px solid #30363d; }
.mf-save { color: #fff; background: #238636; font-weight: 600; }
.mf-save.disabled { opacity: 0.5; }
