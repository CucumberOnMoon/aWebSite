.lib-page {
  height: 100vh;
  background: #0d1117;
  color: #c9d1d9;
  display: flex; flex-direction: column;
  overflow: hidden;
}

.lib-loading {
  display: flex; align-items: center; justify-content: center;
  height: 80vh; font-size: 14px; color: #8b949e;
}

.lib-body {
  flex: 1; display: flex; flex-direction: column;
  overflow: hidden;
}

.lib-sticky {
  flex-shrink: 0;
  background: #0d1117;
  z-index: 5;
}

/* ── 分类标签页 ── */
.lib-tabs {
  display: flex; gap: 6px; white-space: nowrap;
  background: #161b22; border-bottom: 1px solid #30363d;
  padding: 8px 14px;
}
.lib-tab {
  flex: 1; text-align: center; padding: 8px 0;
  font-size: 14px; font-weight: 600; color: #8b949e;
  background: transparent; border-radius: 8px;
}
.lib-tab-active {
  color: #fff; background: #1f6feb;
}

/* ── 肌群下拉 ── */
.lib-picker {
  margin: 10px 14px; flex-shrink: 0;
}
.lib-picker-trigger {
  background: #21262d; border: 1px solid #30363d; border-radius: 8px;
  padding: 10px 14px; display: flex; justify-content: space-between; align-items: center;
}
.lib-arrow { color: #8b949e; font-size: 12px; margin-left: 6px; }

/* ── 动作列表 ── */
.lib-list {
  flex: 1; padding: 0 14px 20px;
}
.lib-ex-card {
  position: relative;
  background: #21262d; border: 1px solid #30363d; border-radius: 10px;
  margin-bottom: 8px; overflow: hidden;
}
.lib-ex-card:active {
  opacity: 0.7;
}
.lib-ex-name {
  display: block; padding: 12px 60px 12px 14px;
  font-size: 14px; font-weight: 600; color: #e6edf3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.lib-ex-muscle {
  position: absolute; right: 10px; top: 50%;
  transform: translateY(-50%);
  font-size: 12px; color: #8b949e;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 48px; text-align: right;
}
.lib-empty {
  text-align: center; padding: 40px 0; color: #8b949e; font-size: 14px;
}

/* ── 复用首页弹窗样式 ── */
.ex-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.65); z-index: 110;
  display: flex; align-items: center; justify-content: center;
}
.ex-popup {
  background: #1c2128; border: 1px solid #444c56; border-radius: 14px;
  padding: 20px; width: 80%; max-width: 320px;
}
.ex-popup-name {
  font-size: 18px; font-weight: 700; color: #e6edf3; display: block;
  margin-bottom: 14px; text-align: center;
}
.ex-popup-label { font-size: 12px; font-weight: 600; color: #8b949e; display: block; margin-bottom: 4px; }
.ex-popup-text {
  font-size: 13px; color: #c9d1d9; line-height: 1.7; display: block;
  padding: 8px 10px; background: #0d1117; border-radius: 8px;
}
.ex-popup-close {
  display: block; text-align: center; color: #58a6ff; font-size: 14px;
  padding: 10px 0 2px; margin-top: 4px;
}
.ex-muscle-imgs {
  display: flex; gap: 8px; margin-bottom: 12px;
}
.ex-muscle-card {
  flex: 1; border-radius: 8px; padding: 6px;
  text-align: center;
}
.ex-muscle-label {
  font-size: 11px; font-weight: 600; display: block;
  margin-bottom: 4px;
}
.ex-muscle-img {
  width: 100%; height: 140px;
}
.ex-gif {
  width: 100%; height: 200px; border-radius: 8px;
  background: #0d1117; margin-bottom: 12px;
}
